            "value": "valore superiore o uguale al limite."
          }
        }
      }
    },
    "value is not a multiple of the required step.": {
      "extractionState": "manual",
      "localizations": {
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "valore non multiplo del passo richiesto."
          }
        }
      }
